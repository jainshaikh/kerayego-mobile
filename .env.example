# ─── API ──────────────────────────────────────────────────────────────────
# Backend runs on port 3001 with global prefix /v1 (see kerayego-backend/src/main.ts)
#
# Android emulator: host machine's localhost is reached via 10.0.2.2
# iOS simulator: localhost works directly -> http://localhost:3001/v1
# Physical device: use your machine's LAN IP, e.g. http://192.168.1.20:3001/v1
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001/v1

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# ─── Maps ─────────────────────────────────────────────────────────────────
# Google Maps API key, restricted to this app's Android package name
# (com.rentalmobile.app) + SHA-1 fingerprint, scoped to Maps SDK for Android
# + Places API (New) only. Do not reuse web's browser/server keys in production.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
